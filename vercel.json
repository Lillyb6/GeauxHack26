{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend",
  "functions": {
    "main.py": {
      "maxDuration": 120,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,frontend/test-fixtures/**,backend/tests/**,docs/**,supabase/**,.venv/**,**/__pycache__/**,**/.env,**/.env.*}"
    }
  }
}
